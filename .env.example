# ── MinIO ─────────────────────────────────────────────────────────────────────
MINIO_ENDPOINT=http://<vm-ip>:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change_me
MINIO_BUCKET_DATA=ocr-data

# ── MLflow ────────────────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://<vm-ip>:5000
MLFLOW_S3_ENDPOINT_URL=http://<vm-ip>:9000

# ── PostgreSQL (dùng bởi docker-compose) ──────────────────────────────────────
POSTGRES_PASSWORD=change_me

# ── HuggingFace ───────────────────────────────────────────────────────────────
HF_TOKEN=hf_...
HF_REPO_DATA=nbdaaa/all-ocr-data

# ── W&B ───────────────────────────────────────────────────────────────────────
WANDB_API_KEY=...
WANDB_PROJECT=chandra-ocr
WANDB_ENTITY=ducanhcttp

# ── Vast.ai ───────────────────────────────────────────────────────────────────
VAST_API_KEY=...
GPU_TEMPLATE_ID=          # Offer ID cho vLLM serving instances
GPU_TRAIN_TEMPLATE_ID=    # Offer ID cho training instance (A40/A100)
TRAIN_DOCKER_IMAGE=pytorch/pytorch:2.3.0-cuda12.1-cudnn8-devel  # image cho training

# SSH config (dùng bởi training trigger + deploy trigger)
VAST_TRAIN_USER=root
VAST_TRAIN_KEY=~/.ssh/id_rsa
REMOTE_WORK_DIR=/workspace/OCR-Optimizing-Mlops
GIT_REPO_URL=https://github.com/<user>/<repo>.git

# ── Nginx + Prometheus (scaler + deploy) ──────────────────────────────────────
NGINX_UPSTREAM_CONF=infra/nginx/upstream.conf
PROMETHEUS_TARGETS_FILE=infra/prometheus/targets.json
NGINX_CONTAINER_NAME=infra-nginx-1
PROMETHEUS_URL=http://localhost:9090

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me

# ── Scaler ────────────────────────────────────────────────────────────────────
SCALER_STATE_FILE=scaler_state.json
