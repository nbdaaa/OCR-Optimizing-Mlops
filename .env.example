# ── MinIO ─────────────────────────────────────────────────────────────────────
MINIO_ENDPOINT=http://<vm-ip>:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change_me
MINIO_BUCKET_DATA=ocr-data

# ── MLflow ────────────────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://<vm-ip>:5000
MLFLOW_S3_ENDPOINT_URL=http://<vm-ip>:9000

# ── PostgreSQL (dùng bởi docker-compose) ──────────────────────────────────────
POSTGRES_PASSWORD=change_me

# ── HuggingFace ───────────────────────────────────────────────────────────────
HF_TOKEN=hf_...
HF_REPO_DATA=nbdaaa/all-ocr-data

# ── W&B ───────────────────────────────────────────────────────────────────────
WANDB_API_KEY=...
WANDB_PROJECT=chandra-ocr
WANDB_ENTITY=ducanhcttp

# ── Vast.ai (scaler + training trigger) ───────────────────────────────────────
VAST_API_KEY=...

# Training instance SSH (dùng bởi POST /training/trigger)
VAST_TRAIN_HOST=<vast-ai-instance-ip>
VAST_TRAIN_PORT=22
VAST_TRAIN_USER=root
VAST_TRAIN_KEY=~/.ssh/id_rsa
REMOTE_WORK_DIR=/workspace/OCR-Optimizing-Mlops

# Scaler serving instances
GPU_TEMPLATE_ID=<vast-ai-template-id>

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me

# ── Scaler ────────────────────────────────────────────────────────────────────
SCALER_STATE_FILE=scaler_state.json
