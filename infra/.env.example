# Compose substitution vars (read from infra/.env by docker compose)

# PostgreSQL
POSTGRES_PASSWORD=change_me_strong_password

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_strong_password

# HuggingFace
HF_TOKEN=hf_...
HF_REPO_DATA=nbdaaa/all-ocr-data

# W&B
WANDB_API_KEY=...
WANDB_PROJECT=chandra-ocr
WANDB_ENTITY=ducanhcttp

# Public endpoints forwarded to remote Vast.ai instances (VM public IP, not
# docker network names — remote instances can't resolve "minio"/"mlflow")
PUBLIC_MLFLOW_TRACKING_URI=http://<vm-public-ip>:5000
PUBLIC_MINIO_ENDPOINT=http://<vm-public-ip>:9000

# Vast.ai orchestration (training/deploy triggers)
# NOTE: no inline comments after a value — docker compose keeps them as part
# of the value. Leave GPU_*_TEMPLATE_ID empty for auto-select (serving/training).
VAST_API_KEY=...
GPU_TEMPLATE_ID=
GPU_TRAIN_TEMPLATE_ID=
TRAIN_DOCKER_IMAGE=pytorch/pytorch:2.3.0-cuda12.1-cudnn8-devel
GIT_REPO_URL=https://github.com/nbdaaa/OCR-Optimizing-Mlops.git
REMOTE_WORK_DIR=/workspace/OCR-Optimizing-Mlops
# Provisioning uses Vast.ai onstart (instance self-bootstraps) — no SSH key needed.
