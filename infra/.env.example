# Compose substitution vars (read from infra/.env by docker compose)

# PostgreSQL
POSTGRES_PASSWORD=change_me_strong_password

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_strong_password

# HuggingFace
HF_TOKEN=hf_...
HF_REPO_DATA=nbdaaa/all-ocr-data

# W&B
WANDB_API_KEY=...
WANDB_PROJECT=chandra-ocr
WANDB_ENTITY=ducanhcttp

# Public endpoints forwarded to remote Vast.ai instances (VM public IP, not
# docker network names — remote instances can't resolve "minio"/"mlflow")
PUBLIC_MLFLOW_TRACKING_URI=http://<vm-public-ip>:5000
PUBLIC_MINIO_ENDPOINT=http://<vm-public-ip>:9000

# Vast.ai orchestration (training/deploy triggers)
# NOTE: no inline comments after a value — docker compose keeps them as part
# of the value. Leave GPU_*_TEMPLATE_ID empty for auto-select (serving/training).
VAST_API_KEY=...
GPU_TEMPLATE_ID=
GPU_TRAIN_TEMPLATE_ID=
# torch 2.7 / CUDA 12.8 → supports Blackwell (sm_120: RTX 5090, RTX PRO) AND
# older cards (sm_80/86/89: A100, 3090, 4090, 6000 Ada). Don't downgrade.
TRAIN_DOCKER_IMAGE=pytorch/pytorch:2.7.0-cuda12.8-cudnn9-devel
GIT_REPO_URL=https://github.com/nbdaaa/OCR-Optimizing-Mlops.git
REMOTE_WORK_DIR=/workspace/OCR-Optimizing-Mlops
# Fast post-train CER + loc_mae eval via the cached vLLM venv (same HF dataset
# repo the Colab serving pool uses). Holds vllm-venv.tar.zst. Leave empty to skip
# the vLLM eval phase (train.py then prints a manual `--recover` hint).
# VLLM_VENV_PYTHON = venv python path INSIDE the tarball (default matches a cache
# that unpacks to /content/vllm-venv).
VLLM_VENV_REPO=
VLLM_VENV_PYTHON=/content/vllm-venv/bin/python
# Auto-select network floor (Mbps up/down). Serving needs a fast link to pull the
# multi-GB vLLM image quickly → default 2000 (raise to 3000 if offers allow).
# Training uses VAST_MIN_INET_MBPS (lower; it pulls less).
VAST_SERVE_MIN_INET_MBPS=2000
VAST_MIN_INET_MBPS=100
# Provisioning uses Vast.ai onstart (instance self-bootstraps) — no SSH key needed.
